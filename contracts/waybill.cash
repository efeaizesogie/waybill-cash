pragma cashscript ^0.14.0;

// Waybill: pay-on-delivery escrow with no arbiter.
//
// The buyer locks BCH here. At handover the buyer reveals a 16-byte secret
// (shown as a QR code). Anyone holding the secret can trigger `release`,
// but the covenant only lets the money go to the seller. If nothing is
// released before `refundAfter` (block height), anyone can trigger `refund`,
// and the covenant only lets the money go back to the buyer.
// No signatures are needed for either path, so the courier/seller and the
// buyer never have to connect a wallet to settle.
contract Waybill(
    bytes20 buyerPkh,
    bytes20 sellerPkh,
    bytes32 releaseHash,
    int refundAfter,
    int maxFee
) {
    function release(bytes secret) {
        require(sha256(secret) == releaseHash);
        require(tx.inputs.length == 1);
        require(tx.outputs.length == 1);
        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(sellerPkh));
        require(tx.outputs[0].value >= tx.inputs[0].value - maxFee);
    }

    function refund() {
        require(tx.time >= refundAfter);
        require(tx.inputs.length == 1);
        require(tx.outputs.length == 1);
        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(buyerPkh));
        require(tx.outputs[0].value >= tx.inputs[0].value - maxFee);
    }
}
